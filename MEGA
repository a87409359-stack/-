local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "NEXUS HUB | MEGA LOADER",
    Author = "Выбери игру",
    Folder = "NexusMain",
    Theme = "Dark",
    Size = UDim2.fromOffset(350, 450), -- Чуть увеличил высоту для новой кнопки
})

Window:SetToggleKey(Enum.KeyCode.RightShift)

local function LoadScript(url, name)
    WindUI:Notify({ Title = "Загрузка", Content = "Загружаем " .. name .. "...", Duration = 2 })
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    if not success then
        WindUI:Notify({ Title = "Ошибка", Content = "Не удалось загрузить скрипт.", Duration = 5 })
    end
end

