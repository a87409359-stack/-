local Window = WindUI:CreateWindow({
    Title = "NEXUS HUB | MEGA LOADER",
    Author = "Выбери игру",
    Folder = "NexusMain",
    Theme = "Dark",
    Size = UDim2.fromOffset(350, 450),
})

Window:SetToggleKey(Enum.KeyCode.RightShift)

-- УМНАЯ ФУНКЦИЯ ЗАГРУЗКИ
local function LoadScript(url, name)
    -- 1. Сразу прячем лоадер, как только нажали кнопку
    Window:SetVisible(false)
    
    WindUI:Notify({ Title = "Загрузка", Content = "Загружаем " .. name .. "...", Duration = 2 })
    
    -- 2. Пытаемся загрузить скрипт
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    
    -- 3. Если скрипт сломался (ошибка в коде или ты не в игре) - возвращаем лоадер
    if not success then
        Window:SetVisible(true) -- Показываем лоадер обратно
        WindUI:Notify({ Title = "Ошибка", Content = "Скрипт не загрузился. Ты в игре?", Duration = 5 })
        warn("[MEGA LOADER ERROR] " .. tostring(err))
    end
end

